+  if (op->code() != CPUI_PIECE && op->code() != CPUI_SUBPIECE) return;
+  const Varnode *a = op->getIn(0);
+  const Varnode *b = op->getIn(1);
+  if (a == (Varnode *)0 || b == (Varnode *)0) return;
+  bool bad;
+  if (op->code() == CPUI_PIECE)
+    bad = (a->getSize() + b->getSize() != op->getOut()->getSize());
