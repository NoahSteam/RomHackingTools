 # All assembly defintions taken from: http://www.shared-ptr.com/sh_insns.html
+# Modified for SaturnExplorer: bra/bsr give their delay slot the PC it executes at (patches/0005-sleigh-delay-slot-pc.patch).
 
 define endian=big;
 
@@ -12,6 +13,16 @@ define register offset=0 size=4
 
 define register offset=0x100 size=4 [sr gbr vbr mach macl pr pc];
 
+# A PC-relative load or mova in the delay slot of a taken branch sees PC = branch target + 2,
+# not its own address + 4. bra and bsr encode their target, so they hand it to the slot through
+# this context: slot_tgt is (target + 2) >> 1 -- the slot's PC, which is even -- and
+# slot_pc_valid says it is set. Both are noflow, so they hold for the slot's address only.
+define register offset=0x400 size=4 [contextreg];
+define context contextreg
+    slot_pc_valid = (0,0) noflow
+    slot_tgt      = (1,31) noflow
+;
+
 
 @if SH_VERSION == "2A"
 define register offset=0x180 size=4 [tbr];
