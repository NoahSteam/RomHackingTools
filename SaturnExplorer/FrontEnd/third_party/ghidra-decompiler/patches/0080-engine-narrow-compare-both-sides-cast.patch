+/// \brief The type the unflagged side of an equality compare is cast to when the other side is cast
+///
+/// \b checkIntPromotionForCompare says whether C would extend this input differently from the other one. When it says so of the other input (or the other
+/// input is already the output of the cast made for it) and not of this one, \b getInputCast casts the other to the lower-ordered of the two types (\b reqtype) and this one, a named variable or a cast that C extends
+/// by its own type, was left alone: with \b reqtype a \b uint2 and this side an \b int2, the \b (uint2) on the other side changes nothing in C and
+/// \b (uint2)(x & 0xff80) == (int2)y extends the two sides one by zero and one by sign, where the code compares two bytes. This side is cast to
+/// \b reqtype too, so that C extends both the same way. (A constant is cast to the other side's type by compareCastTarget, and is not paired.)
+/// \param op is the comparison
+/// \param slot is the input being asked about
+/// \param reqtype is the lower-ordered of the two types
+/// \param castStrategy is the cast strategy
+/// \param tlst is the type factory
+/// \return the data-type to cast the input to, or null
+static Datatype *compareOtherSideCast(const PcodeOp *op,int4 slot,Datatype *reqtype,const CastStrategy *castStrategy,TypeFactory *tlst)
+
+{
+  const Varnode *vn = op->getIn(slot);
+  const Varnode *othervn = op->getIn(1-slot);
+  if (vn->isConstant() || othervn->isConstant()) return (Datatype *)0;
+  if (vn->getSize() >= tlst->getSizeOfInt()) return (Datatype *)0;
+  // The cast pass takes the inputs in order, so the other side is already the output of the CAST it made when it is slot 0
+  if (!othervn->isWritten() || othervn->getDef()->code() != CPUI_CAST) {
+    if (!castStrategy->checkIntPromotionForCompare(op,1-slot)) return (Datatype *)0;
+  }
+  type_metatype meta = vn->getHighTypeReadFacing(op)->getMetatype();
+  type_metatype reqmeta = reqtype->getMetatype();
+  if ((meta != TYPE_INT && meta != TYPE_UINT) || (reqmeta != TYPE_INT && reqmeta != TYPE_UINT)) return (Datatype *)0;
+  if (meta == reqmeta || reqtype->getSize() != vn->getSize()) return (Datatype *)0;
+  return reqtype;
+}
