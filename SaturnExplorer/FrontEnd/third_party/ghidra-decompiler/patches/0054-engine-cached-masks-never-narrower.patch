+      res = a;
+    }
+    else
+      res = (outc==0) ? 0 : ~((uintb)0);
+    return true;
+  case CPUI_INT_LESS:
+  case CPUI_INT_LESSEQUAL:
+  case CPUI_INT_EQUAL:
+  case CPUI_INT_NOTEQUAL:
+    if (outc==0)
+      res = 0;
