+    return true;
+  case CPUI_INT_LEFT:
+    if (getIn(1)->isConstant()) {
+      if (slot == 1) {
+	res = (outc == 0) ? 0 : ~((uintb)0);
+	return true;
+      }
+      sz = output->getSize();
+      int4 sa = getIn(1)->getOffset();
+      if (sz > sizeof(uintb)) {	// If there exists bits beyond the precision of the consume field
+	if (sa >= 8*sizeof(uintb))
