+  case CPUI_INSERT:
+    a = 1;
+    a <<= (int4)getIn(3)->getOffset();
+    a -= 1;	// Insert mask
+    if (slot == 1)
+      res = a;
+    else if (slot == 0) {
+      a <<= (int4)getIn(2)->getOffset();
+      res = outc & ~a;
+    }
+    else
+      res = (outc == 0) ? 0 : ~((uintb)0);
+    return true;
+  case CPUI_ZPULL:
+  case CPUI_SPULL:
+    if (slot != 0) {
+      res = (outc == 0) ? 0 : ~((uintb)0);
+      return true;
+    }
+    a = 1;
+    a <<= (int4)getIn(2)->getOffset();
+    a -= 1;	// Pull mask
