+/// \brief Keep the writes of global storage made on a path that never returns (SaturnExplorer, 0087)
+///
+/// A global's value is live at a RETURN only, through the COPY heritage puts there (Heritage::guardReturns), so a write that no
+/// RETURN can follow (a loop the analysis takes to run for ever, such as a poll of memory it folds, or a call that does not return)
+/// had no reader and went as dead: the store the code makes before the loop vanished, and the register that held the global's old
+/// value could then merge with it, printing a write the code never makes. Memory another processor or an interrupt reads sees the
+/// writes made before such a loop, so each write of persistent storage in a block from which a block that never returns is
+/// reachable is consumed and address forced, as the COPY at a RETURN is. A function whose every block reaches a RETURN is not changed.
+/// \param data is the function being analyzed
+/// \param worklist is the consume work list
+void ActionDeadCode::keepGlobalWritesWithoutReturn(Funcdata &data,vector<Varnode *> &worklist)
+
+{
+  const BlockGraph &bbs(data.getBasicBlocks());
+  int4 n = bbs.getSize();
+  if (n == 0) return;
+  vector<char> returns(n,0);
+  vector<FlowBlock *> work;
+  list<PcodeOp *>::const_iterator iter = data.beginOp(CPUI_RETURN);
+  list<PcodeOp *>::const_iterator enditer = data.endOp(CPUI_RETURN);
+  for(;iter!=enditer;++iter) {
+    PcodeOp *op = *iter;
+    if (op->isDead()) continue;
+    FlowBlock *bl = op->getParent();
+    if (returns[bl->getIndex()]) continue;
+    returns[bl->getIndex()] = 1;
+    work.push_back(bl);
+  }
+  while(!work.empty()) {		// every block from which a RETURN is reachable
+    FlowBlock *bl = work.back();
+    work.pop_back();
+    for(int4 i=0;i<bl->sizeIn();++i) {
+      FlowBlock *in = bl->getIn(i);
+      if (returns[in->getIndex()]) continue;
+      returns[in->getIndex()] = 1;
+      work.push_back(in);
+    }
+  }
+  vector<char> dooms(n,0);	// every block from which a block that never returns is reachable
+  for(int4 i=0;i<n;++i) {
+    if (returns[i]) continue;
+    dooms[i] = 1;
+    work.push_back(bbs.getBlock(i));
+  }
+  if (work.empty()) return;
+  while(!work.empty()) {
+    FlowBlock *bl = work.back();
+    work.pop_back();
+    for(int4 i=0;i<bl->sizeIn();++i) {
+      FlowBlock *in = bl->getIn(i);
+      if (dooms[in->getIndex()]) continue;
+      dooms[in->getIndex()] = 1;
+      work.push_back(in);
+    }
+  }
+  AddrSpace *dataSpc = data.getArch()->getDefaultDataSpace();
+  VarnodeLocSet::const_iterator viter = data.beginLoc(dataSpc);
+  VarnodeLocSet::const_iterator endviter = data.endLoc(dataSpc);
+  for(;viter!=endviter;++viter) {
+    Varnode *vn = *viter;
+    if (!vn->isWritten() || !vn->isPersist()) continue;
+    const PcodeOp *def = vn->getDef();
+    if (def->isDead() || def->code() == CPUI_INDIRECT || def->code() == CPUI_MULTIEQUAL) continue;
+    if (!dooms[def->getParent()->getIndex()]) continue;
+    vn->setAddrForce();		// held between the passes too: RuleEarlyRemoval takes a write that nothing reads and that is not forced
+    pushConsumed(~((uintb)0),vn,worklist);
+  }
+}
