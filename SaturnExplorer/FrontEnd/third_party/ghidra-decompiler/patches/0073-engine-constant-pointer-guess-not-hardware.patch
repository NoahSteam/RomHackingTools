+/// \brief Is the value of a COPY used as an address, as far as the data flow shows?
+///
+/// Follows the value through copies, merges, casts and the additions and masks that make an address from it, to a LOAD or STORE
+/// whose pointer it is, a call it is handed to (its callee may use it so) or a value stored to memory. A value that reaches only a
+/// return, a compare or an arithmetic result is a number, whatever it equals. A walk that does not end soon says yes.
+/// \param vn is the output of the COPY
+/// \return \b true if the value may be used as an address
+static bool copyUsedAsAddress(Varnode *vn)
+
+{
+  vector<Varnode *> work;
+  set<Varnode *> seen;
+  work.push_back(vn);
+  seen.insert(vn);
+  while(!work.empty()) {
+    if (seen.size() > 128) return true;
+    Varnode *cur = work.back();
+    work.pop_back();
+    list<PcodeOp *>::const_iterator iter;
+    for(iter=cur->beginDescend();iter!=cur->endDescend();++iter) {
+      PcodeOp *use = *iter;
+      switch(use->code()) {
+      case CPUI_LOAD:		// its pointer is slot 1 (slot 0 is the space)
+      case CPUI_STORE:		// as the pointer or as the value stored
+      case CPUI_CALL:
+      case CPUI_CALLIND:
+      case CPUI_CALLOTHER:
+	return true;
+      case CPUI_COPY:
+      case CPUI_CAST:
+      case CPUI_MULTIEQUAL:
+      case CPUI_INDIRECT:
+      case CPUI_INT_ADD:
+      case CPUI_INT_SUB:
+      case CPUI_INT_AND:
+      case CPUI_INT_OR:
+      case CPUI_INT_XOR:
+      case CPUI_PTRADD:
+      case CPUI_PTRSUB:
+	{
+	  Varnode *out = use->getOut();
+	  if (out != (Varnode *)0 && seen.insert(out).second)
+	    work.push_back(out);
+	}
+	break;
+      default:
+	break;
+      }
+    }
+  }
+  return false;
+}
