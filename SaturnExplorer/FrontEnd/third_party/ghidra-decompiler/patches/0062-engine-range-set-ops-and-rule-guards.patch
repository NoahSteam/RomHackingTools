 void CircleRange::widen(const CircleRange &op2,bool leftIsStable)
 
 {
+  // SaturnExplorer (patches/0062-engine-range-set-ops-and-rule-guards.patch): the widened range holds the old one, in the old range's step and phase.
+  // The right bound is upstream's (the landmark's, in the phase of the range: a landmark that contains the range ends at or after it, so the bound
+  // is never short of the range's last element); the left bound is the first element of the range's phase at or above the landmark's (upstream
+  // took the landmark's bound as it was, in the wrong phase for a stride above the landmark's). A full landmark has no end to move to: when the bound
+  // it gives cuts the old range (a wrapped range moved to [left,0)) the answer is all of the phase.
+  if (isempty) return;
+  const uintb phase = left % step;
+  const uintb oldLeft = left;
+  const uintb oldRight = right;
   if (leftIsStable) {
-    uintb lmod = left % step;
     uintb mod = op2.right % step;
-    if (mod <= lmod)
-      right = op2.right + (lmod - mod);
+    if (mod <= phase)
+      right = op2.right + (phase - mod);
     else
-      right = op2.right - (mod - lmod);
+      right = op2.right - (mod - phase);
     right &= mask;
   }
   else {
-    left = op2.left & mask;
+    const uintb mod = op2.left % step;
+    left = (op2.left + (phase + step - mod) % step) & mask;
+  }
+  // The length of the arc from left to right for the new range and the old (one bound has moved, the other is the same); equal bounds are the
+  // whole circle. The new range holds the old one if its arc is not shorter.
+  const uintb newDist = (right - left) & mask;
+  const uintb oldDist = (oldRight - oldLeft) & mask;
+  const bool holds = newDist == 0 || (oldDist != 0 && newDist >= oldDist);
+  if (!holds) {
+    left = phase;
+    right = phase;
   }
   normalize();
 }
