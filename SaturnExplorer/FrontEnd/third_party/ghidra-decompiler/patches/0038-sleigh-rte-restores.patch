diff --git a/Ghidra/Processors/SuperH/data/languages/superh.sinc b/Ghidra/Processors/SuperH/data/languages/superh.sinc
index 0d7305d..06adb4d 100644
--- a/Ghidra/Processors/SuperH/data/languages/superh.sinc
+++ b/Ghidra/Processors/SuperH/data/languages/superh.sinc
@@ -4,6 +4,7 @@
 # SR loads keep only the bits the SH-2 has and rte restores SR before its delay slot (patches/0019-sleigh-sr-rte.patch).
 # trapa gives back the 8 bytes its handler's rte pops, after the call (patches/0025-sleigh-trapa-stack.patch).
 # ldc to SR, GBR and VBR also call a user op that carries the value written (patches/0034-sleigh-control-register-writes.patch).
+# rte also calls Write_SR with the SR it restores and Rte_PC with the PC it returns to (patches/0038-sleigh-rte-restores.patch).
 
 define endian=big;
 
@@ -1682,6 +1683,7 @@ MovMUReg2: MovMUReg2_15 is MovMUReg2_15 {
 define pcodeop Write_SR;
 define pcodeop Write_GBR;
 define pcodeop Write_VBR;
+define pcodeop Rte_PC;
 
 :ldc    rm_08_11,sr  is sr & opcode_12_15=0b0100 & rm_08_11 & opcode_00_07=0b00001110 
 {
@@ -1796,9 +1798,15 @@ define pcodeop Write_VBR;
     # SR is restored before the delay slot runs, the branch target is taken after it: a slot
     # that reads T sees the restored one, and a slot that writes T is not undone by the restore.
     sr = _sr;
+    Write_SR(_sr);
 
     delayslot(1);
     
+    # The stacked SR and PC are what the interrupted code resumes with. A handler that changes them (a status
+    # returned in T, an instruction skipped) is not doing nothing: the return target is dropped from the data-flow
+    # at a RETURN, so the load of it, and the store that fed the load, were removed. The user op keeps them
+    # (patches/0038-sleigh-rte-restores.patch).
+    Rte_PC(_pc);
     pc = _pc;
     
     return [pc];
