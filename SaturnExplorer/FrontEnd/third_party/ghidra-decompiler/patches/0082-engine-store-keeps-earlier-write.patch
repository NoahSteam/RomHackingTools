+/// \brief Whether a memory access lies after \b from and before \b to in their basic block (SaturnExplorer, 0082)
+///
+/// A LOAD, a STORE, a call or a CALLOTHER (the host's volatile accesses are CALLOTHERs) after \b from in its block and before \b to,
+/// or before the end of the block when \b to is null. \b true, the cautious answer, when \b to is in another block.
+/// \param from is the op the walk starts after
+/// \param to is the op it ends before, or null for the end of the block
+/// \return \b true if such an access was found
+static bool accessBetween(const PcodeOp *from,const PcodeOp *to)
+
+{
+  if (to != (const PcodeOp *)0 && to->getParent() != from->getParent()) return true;
+  list<PcodeOp *>::iterator iter = from->getBasicIter();
+  const BlockBasic *bl = from->getParent();
+  for(++iter;iter!=bl->endOp();++iter) {
+    const PcodeOp *op = *iter;
+    if (op == to) return false;
+    switch(op->code()) {
+    case CPUI_LOAD: case CPUI_STORE: case CPUI_CALL: case CPUI_CALLIND: case CPUI_CALLOTHER:
+      return true;
+    default:
+      break;
+    }
+  }
+  return false;
+}
