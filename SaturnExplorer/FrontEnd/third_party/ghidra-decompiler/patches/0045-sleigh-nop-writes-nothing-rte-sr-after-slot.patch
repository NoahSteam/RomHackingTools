     sr = _sr;
-    Write_SR(_sr);
 
     delayslot(1);
+
+    # ...and what the interrupted code resumes with is the SR after the slot (Mednafen's RTE restores SR, then runs the slot): a
+    # handler that returns a status in T by `rte ; sett` is not doing nothing (A2-36,
+    # patches/0045-sleigh-nop-writes-nothing-rte-sr-after-slot.patch).
+    Write_SR(sr);
     
