+/// SaturnExplorer. The function's code passes the address of one of its locals to a callee by a
+/// route its p-code does not show once dead code is gone (a register that is no input of the call),
+/// so the local would be taken for one nothing can reach. The host says where the pointer points:
+/// every local at or above the offset is then treated as aliased, as if a Varnode holding the
+/// pointer were still there. The declaration lasts as long as the function (it is not cleared with
+/// the analysis, which the host cannot see when it restarts).
+/// \param off is the stack offset the pointer points to
+void ScopeLocal::declareHostAlias(uintb off)
+
+{
+  if (!hostAlias || off < hostAliasStart) hostAliasStart = off;
+  hostAlias = true;
+}
+
+/// \param off receives the lowest offset declared
+/// \return \b true if the host declared a pointer
+bool ScopeLocal::getHostAlias(uintb &off) const
+
+{
+  off = hostAliasStart;
+  return hostAlias;
+}
