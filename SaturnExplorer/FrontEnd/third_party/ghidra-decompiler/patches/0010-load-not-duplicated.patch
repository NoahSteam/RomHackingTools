+bool ActionMarkExplicit::containsLoad(Varnode *vn)
+
+{
+  vector<Varnode *> work;
+  set<Varnode *> seen;
+  work.push_back(vn);
+  while(!work.empty()) {
+    Varnode *cur = work.back();
+    work.pop_back();
+    if (!cur->isWritten()) continue;
+    if (cur != vn && cur->isExplicit()) continue;
+    if (!seen.insert(cur).second) continue;
+    PcodeOp *op = cur->getDef();
