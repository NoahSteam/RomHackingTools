# Area 3, A3-203 and A3-204. Run with W=<SaturnExplorer> S=<scratch> run.sh (or run.py <name>). Each x fixture is vCr8's caller (a local of 5, its address in r8,
# two calls in a row, 7 stored through r8, the local returned) with F1 vCr8's (clears r8 when r3 != 0 and r4 = 0) and F2 as said.
name x4s
# A3-203 (A3-202's x4s): F2 is F1 (the same callee called twice): r8 is as either call left it (the second may keep what the first cleared): both marked, the caution at the first call, "likewise"
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
bsr F1
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r8
rts
nop
K1:
rts
nop
name x4w
# A3-203 control: F2 overwrites r8 on every path (two returns: `mov #0,r8` or `mov #4,r8`): nothing of F1's r8 is read; the caution at F2's call only
ret 1,0,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
bsr F2
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r8
rts
nop
K1:
rts
nop
fn
F2:
tst r3,r3
bt K2
mov #0,r8
rts
nop
K2:
mov #4,r8
rts
nop
name x4j
# A3-203 control: x4w with F2's two paths meeting at one `rts ; mov r3,r0` (not lent: it returns r3; a join of two overwrites, Value::sureWritten): the caution at F2's call only
ret 1,0,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
