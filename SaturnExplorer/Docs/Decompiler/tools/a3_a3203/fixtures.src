name x4t
# A3-203: F2 clears r8 on one path and on the other tail-jumps to F3 (`mov.l =F3,r1 ; jmp @r1`), which keeps r8: the walk of F2 reads one return only (the jump ends its path, mPathLost), so F2 is not taken to overwrite r8: both marked, one caution at F1's call, "likewise"
ret 1,0,0,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
