tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r8
rts
nop
K1:
rts
nop
fn
F2:
tst r3,r3
bt K2
bra J2
mov #0,r8
K2:
mov #4,r8
J2:
rts
mov r3,r0
