# ---- 6. A3-212's exclusion (the stale-stack test) ----
# kn1: F0 reads an uninitialised word of its frame (`mov.l @r15,r0` after `add #-8,r15`) and stores it through r4, then calls a lent L that
# sets r9 to 3; F0 never reads r9. Run with SE_GENERATED_MUTATE=kept (the text made to read `unaff_r9`): the kept-read check must report r9
name kn1
ret 0,0
env SE_GENERATED_CLOBBERS=200,200
.word 0x4F22
add #-8,r15
mov.l @r15,r0
mov.l r0,@r4
bsr L
nop
add #8,r15
.word 0x4F26
rts
nop
fn
L:
mov #3,r9
rts
nop
