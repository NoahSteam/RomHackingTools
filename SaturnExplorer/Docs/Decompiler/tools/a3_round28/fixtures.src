# Area 3 round 28 review: fixtures (run with run.sh / run.py: W=<SaturnExplorer> S=<scratch>). Unless said, F1 is U: not lent (it returns r3),
# clears r8 when r3 = 0 (input mode 0's r3 is 0, the other modes' are random), so the oracle's runs need the caution when the caller reads r8.
#
# ---- 1. The oracle (CheckCautions): what it compares ----
# o1: the caller keeps 5 in r8 across U and stores r8 to a work-RAM global (0x26002000), returns nothing. Runs store 5 or 0.
name o1
ret 0,0
env SE_GENERATED_CLOBBERS=0,100
.word 0x4F22
mov.l r8,@-r15
mov #5,r8
bsr F1
nop
mov.l =0x26002000,r1
mov.l r8,@r1
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bf K1
mov #0,r8
K1:
rts
mov r3,r0
