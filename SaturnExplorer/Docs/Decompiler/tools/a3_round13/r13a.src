name R13-2a frame address in the stack argument word of an unlent call (r5-r7 unset: the engine drops it); g reads and publishes it, w walks down from it: engine gives return 5 (the note says only "from there up"), run gives 0x55
asm 06009000
.word 0x4F22
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r1
add #8,r1
add #-4,r15
mov.l r1,@r15
mov.l =0x06009100,r1
jsr @r1
nop
add #4,r15
mov.l =0x06009180,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov.l @r15,r1
mov.l =0x0600F100,r2
mov.l r1,@r2
rts
nop
endasm
asm 06009180
mov.l =0x0600F100,r1
mov.l @r1,r1
mov #0x55,r2
mov.l r2,@-r1
mov.l r2,@-r1
rts
nop
endasm
args 0 0 0 0
end
name R13-2b the same with the address also in r4
asm 06009000
.word 0x4F22
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #8,r4
mov r4,r1
add #-4,r15
mov.l r1,@r15
mov.l =0x06009100,r1
jsr @r1
nop
add #4,r15
mov.l =0x06009180,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov.l @r15,r1
mov.l =0x0600F100,r2
mov.l r1,@r2
rts
nop
endasm
asm 06009180
mov.l =0x0600F100,r1
mov.l @r1,r1
mov #0x55,r2
mov.l r2,@-r1
mov.l r2,@-r1
rts
nop
endasm
args 0 0 0 0
end
