asm 06009100
add #-4,r15
mov r15,r1
add #4,r1
mov.l r1,@r15
mov.l @r15,r3
mov #7,r0
mov.l r0,@r3
add #4,r15
rts
nop
endasm
lend 06009100
args 0 0 0 0
end
name R13-3.2 the same reloaded through a swap-pair laundered address of the local: g lent, text returns 5, run gives 7
asm 06009000
.word 0x4F22
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009100,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
add #-4,r15
mov r15,r1
add #4,r1
mov.l r1,@r15
mov r15,r2
swap.w r2,r2
swap.w r2,r2
mov.l @r2,r3
mov #7,r0
mov.l r0,@r3
add #4,r15
rts
nop
endasm
lend 06009100
args 0 0 0 0
end
