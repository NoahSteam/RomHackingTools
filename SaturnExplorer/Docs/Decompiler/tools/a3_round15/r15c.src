add #8,r1
mov.l r1,@r15
mov #77,r3
mov.l r3,@(8,r15)
mov.l @r15,r2
mov.l r5,@r2
mov.l @r15,r4
mov.l =0x06009100,r1
jsr @r1
nop
mov.l @(8,r15),r0
add #16,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov.l @r4,r0
rts
nop
endasm
args 0 0 0 0
args 1 2 3 4
end

