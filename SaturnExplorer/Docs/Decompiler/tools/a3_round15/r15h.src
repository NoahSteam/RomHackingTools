mov.l r3,@(20,r15)
mov #-45,r2
mov.l @(32,r15),r1
add #10,r1
mov.w r2,@r1
mov.l @(20,r15),r0
add #48,r15
.word 0x4F26
rts
nop
endasm
args 0 0 0 0
args 1 2 3 4
end

