mov r15,r1
add #8,r1
mov.l r1,@r15
mov.l @r15,r2
mov.l r5,@r2
mov.l @r15,r4
mov.l =0x06009100,r1
jsr @r1
nop
mov.l @(8,r15),r0
add #16,r15
.word 0x4F26
rts
nop
endasm
