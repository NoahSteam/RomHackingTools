name R15-14a word stored to a global (mailbox) instead of returned
asm 06009000
.word 0x4F22
add #-48,r15
mov r15,r1
add #12,r1
mov.l r1,@(32,r15)
mov.l @(32,r15),r1
add #6,r1
mov.w r5,@r1
mov.l @(32,r15),r1
add #4,r1
mov.w r6,@r1
mov.l @(16,r15),r1
mov.l =0x0600F000,r2
mov.l r1,@r2
mov #0,r0
add #48,r15
.word 0x4F26
rts
nop
endasm
args 11112222 33334444 55556666 77778888
args ffff0001 00008000 12345678 0000ffff
end

name R15-14b word passed to a lent callee as r4 and its result returned
lend 06009100
asm 06009000
.word 0x4F22
add #-48,r15
mov r15,r1
add #12,r1
mov.l r1,@(32,r15)
mov.l @(32,r15),r1
add #6,r1
mov.w r5,@r1
mov.l @(32,r15),r1
add #4,r1
mov.w r6,@r1
mov.l @(16,r15),r4
mov.l =0x06009100,r1
jsr @r1
nop
add #48,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov r4,r0
rts
nop
endasm
args 11112222 33334444 55556666 77778888
args ffff0001 00008000 12345678 0000ffff
end

name R15-14c word added to param then returned
asm 06009000
.word 0x4F22
add #-48,r15
mov r15,r1
add #12,r1
mov.l r1,@(32,r15)
mov.l @(32,r15),r1
add #6,r1
mov.w r5,@r1
mov.l @(32,r15),r1
add #4,r1
mov.w r6,@r1
mov.l @(16,r15),r1
mov r7,r0
add r1,r0
add #48,r15
.word 0x4F26
rts
nop
endasm
args 11112222 33334444 55556666 77778888
args ffff0001 00008000 12345678 0000ffff
end

