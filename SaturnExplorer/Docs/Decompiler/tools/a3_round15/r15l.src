name R15-11a h r2@+2, h r2@+0 (read word)
asm 06009000
.word 0x4F22
add #-48,r15
mov r15,r1
add #12,r1
mov.l r1,@(32,r15)
mov.l @(32,r15),r1
add #6,r1
mov.w r2,@r1
mov.l @(32,r15),r1
add #4,r1
mov.w r2,@r1
mov #0,r0
mov r15,r1
add #12,r1
add #4,r1
mov.l @r1,r3
xor r3,r0
add #48,r15
.word 0x4F26
rts
nop
endasm
args 0 0 0 0 r2=12345678 r3=9abcdef0 r9=0f0f0f0f
args 0 0 0 0 r2=0000ffff r3=11112222 r9=7e7e7e7e
end

