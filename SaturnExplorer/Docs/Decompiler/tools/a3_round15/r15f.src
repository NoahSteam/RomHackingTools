name R15-5a r8
asm 06009000
.word 0x4F22
add #-16,r15
mov.l r8,@(8,r15)
mov r15,r1
add #8,r1
mov.l r1,@r15
mov.l @r15,r2
mov.l r5,@r2
mov.l @(8,r15),r0
add #16,r15
.word 0x4F26
rts
nop
endasm
args 0 0 0 0 r8=11 r9=22 r14=33 r3=44 r2=55
args 1 2 3 4 r8=66 r9=77 r14=88 r3=99 r2=111
end

