name J1 the caller hands a lent fill-backwards callee a pointer chosen between a frame address and a global
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
tst r5,r5
bt S
mov.l =0x0600F200,r4
S:
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov #4,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
endasm
lend 06009040
args 0 0 0 0
args 0 0 1 0
end
