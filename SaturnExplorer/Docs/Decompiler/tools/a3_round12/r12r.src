mov r15,r4
add #16,r4
tst r5,r5
bt S
mov r5,r4
S:
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov #4,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
