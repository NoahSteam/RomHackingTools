name S3a g writes the word at its entry r15 (the caller's outgoing slot) through a laundered stack address; the caller reads the slot back
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov r15,r1
swap.w r1,r1
swap.w r1,r1
mov #7,r2
mov.l r2,@r1
rts
nop
endasm
lend 06009040
args 0 0 0 0
end
name S3b control: g writes the same word through an exact stack address (A3-21: g is withheld)
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov r15,r1
mov #7,r2
mov.l r2,@r1
rts
nop
endasm
lend 06009040
args 0 0 0 0
end
name S3c g writes the word at its entry r15 + 4 through a masked stack address (and #-4, compiled alignment)
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@(4,r15)
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @(4,r15),r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov r15,r1
add #4,r1
mov #-4,r3
and r3,r1
mov #7,r2
mov.l r2,@r1
rts
nop
endasm
lend 06009040
args 0 0 0 0
end
name S3d f hands a laundered address of its caller's outgoing slot (entry r15 + 0) to a lent writer h; the top caller reads the slot back
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
.word 0x4F22
mov r15,r4
add #4,r4
swap.w r4,r4
swap.w r4,r4
mov.l =0x06009080,r1
jsr @r1
nop
.word 0x4F26
rts
nop
endasm
asm 06009080
mov #7,r2
rts
mov.l r2,@r4
endasm
lend 06009080 06009040
args 0 0 0 0
end
