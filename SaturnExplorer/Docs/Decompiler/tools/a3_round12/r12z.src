name L1 a frame address laundered by a mask is handed to an unlent captured callee (hidden r3) that fills backwards from r4
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov #-4,r3
and r3,r4
mov #4,r3
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov r3,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
endasm
args 0 0 0 0
end
name L2 the same, the frame address laundered by a global round trip
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x0600F100,r2
mov.l r4,@r2
mov.l @r2,r4
mov #4,r3
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov r3,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
endasm
args 0 0 0 0
end
