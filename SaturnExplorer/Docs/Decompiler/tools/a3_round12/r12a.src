name C1a callee g leaks the frame address to a global, callee h fills backwards from the global
asm 06009000
.word 0x4F22
add #-20,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov.l =0x06009080,r1
jsr @r1
nop
mov.l @r15,r0
add #20,r15
.word 0x4F26
rts
nop
endasm
asm 06009040
mov.l =0x0600F100,r1
mov.l r4,@r1
rts
nop
endasm
asm 06009080
mov.l =0x0600F100,r1
mov.l @r1,r1
mov #4,r2
L:
mov.l r2,@-r1
dt r2
bf L
rts
nop
endasm
lend 06009040 06009080
args 0 0 0 0
end
