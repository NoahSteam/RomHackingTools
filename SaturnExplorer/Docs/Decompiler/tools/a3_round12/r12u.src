name SA global: a laundered store up into the incoming stack argument word, read back after
asm 06009000
add #-8,r15
mov r15,r1
add #8,r1
mov.l =0x0600F100,r3
mov.l r1,@r3
mov.l @r3,r1
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name SB global: the same with a read of the stack argument BEFORE and after
asm 06009000
add #-8,r15
mov.l @(8,r15),r5
mov r15,r1
add #8,r1
mov.l =0x0600F100,r3
mov.l r1,@r3
mov.l @r3,r1
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
add r5,r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name SA halves: a laundered store up into the incoming stack argument word, read back after
asm 06009000
add #-8,r15
mov r15,r1
add #8,r1
add #-4,r15
mov r1,r0
mov.w r0,@(2,r15)
shlr16 r0
mov.w r0,@(0,r15)
mov.l @r15,r1
add #4,r15
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name SB halves: the same with a read of the stack argument BEFORE and after
asm 06009000
add #-8,r15
mov.l @(8,r15),r5
mov r15,r1
add #8,r1
add #-4,r15
mov r1,r0
mov.w r0,@(2,r15)
shlr16 r0
mov.w r0,@(0,r15)
mov.l @r15,r1
add #4,r15
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
add r5,r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name SA rotl: a laundered store up into the incoming stack argument word, read back after
asm 06009000
add #-8,r15
mov r15,r1
add #8,r1
rotl r1
rotr r1
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
rts
add #8,r15
endasm
args 1 2 3 4
end
