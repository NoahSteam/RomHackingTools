name S4a f pushes r14, hands a laundered copy of r15 (the slot of the saved r14) to a lent writer h, pops r14: f preserves r14 only by the host's sparing
asm 06009000
.word 0x082A
mov #5,r14
mov.l =0x06009040,r1
jsr @r1
nop
mov r14,r0
.word 0x482A
rts
nop
endasm
asm 06009040
.word 0x4F22
mov.l r14,@-r15
mov r15,r4
swap.w r4,r4
swap.w r4,r4
mov.l =0x06009080,r1
jsr @r1
nop
mov.l @r15+,r14
.word 0x4F26
rts
nop
endasm
asm 06009080
mov #7,r2
rts
mov.l r2,@r4
endasm
lend 06009080 06009040
args 0 0 0 0
end
