name S2a laundered frame address stepped UP into the stack argument at the entry r15, which is read back
asm 06009000
add #-8,r15
mov r15,r1
add #8,r1
swap.w r1,r1
swap.w r1,r1
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name S2b control: the same with an exact frame address
asm 06009000
add #-8,r15
mov r15,r1
add #8,r1
mov #7,r2
mov.l r2,@r1
mov.l @(8,r15),r0
rts
add #8,r15
endasm
args 1 2 3 4
end
name S2c laundered address of a local stepped up over two locals
asm 06009000
add #-16,r15
mov #5,r0
mov.l r0,@(8,r15)
mov r15,r1
swap.w r1,r1
swap.w r1,r1
mov #7,r2
mov.l r2,@(8,r1)
mov.l @(8,r15),r0
rts
add #16,r15
endasm
args 1 2 3 4
end
