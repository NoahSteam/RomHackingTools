name RG return_global: g1 stores r4 to a global, g2 returns the global in r0
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov.l =0x06009080,r1
jsr @r1
nop
mov r0,r2
mov #4,r3
L:
mov.l r3,@-r2
dt r3
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm

asm 06009040
mov.l =0x0600F100,r1
rts
mov.l r4,@r1
endasm
asm 06009080
mov.l =0x0600F100,r1
rts
mov.l @r1,r0
endasm
lend 06009040 06009080
args 0 0 0 0
end
name SH stack_home: g spills r4 into [its r15+4] (the caller frame), caller reloads
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @(4,r15),r2
mov #4,r3
L:
mov.l r3,@-r2
dt r3
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm

asm 06009040
rts
mov.l r4,@(4,r15)
endasm
lend 06009040
args 0 0 0 0
end
name GB gbr: g loads gbr from r4; caller reads gbr
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
stc gbr,r2
mov #4,r3
L:
mov.l r3,@-r2
dt r3
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm

asm 06009040
rts
ldc r4,gbr
endasm
lend 06009040
args 0 0 0 0
end
