bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm

asm 06009040
rts
lds r4,mach
endasm
lend 06009040
args 0 0 0 0
end
name R8 r8: g moves r4 into r8 (callee-saved by the default model)
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov r8,r2
mov r2,r2
mov #4,r3
L:
mov.l r3,@-r2
dt r3
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm

asm 06009040
rts
mov r4,r8
endasm
lend 06009040
args 0 0 0 0
end
