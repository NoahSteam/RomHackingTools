name S6 swap: load of a local through a laundered frame address
asm 06009000
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r1
swap.w r1,r1
swap.w r1,r1
mov.l @r1,r0
rts
add #16,r15
endasm
args 0 0 0 0
end
name S6w swap: store then load of a local through a laundered frame address, then a read of the local
