name S5a struct-return pointer r2 = a laundered (swap pair) frame address; unlent g writes through r2
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r2
swap.w r2,r2
swap.w r2,r2
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov #7,r1
rts
mov.l r1,@r2
endasm
args 0 0 0 0
end
name S5b control: r2 = the exact frame address (A3-4)
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r2
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov #7,r1
rts
mov.l r1,@r2
endasm
args 0 0 0 0
end
name S5c r2 = the frame address masked with and #-4 (compiled alignment of a local aggregate)
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov r15,r2
mov #-4,r3
and r3,r2
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
mov #7,r1
rts
mov.l r1,@r2
endasm
args 0 0 0 0
end
