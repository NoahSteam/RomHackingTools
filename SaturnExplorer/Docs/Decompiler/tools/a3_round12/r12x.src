name U1 jsr @r1 where r1 is loaded from a global (the target is not known to the decompiler); the callee fills backwards from r4
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x0600F100,r2
mov.l @r2,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009080
mov #4,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
endasm
long 0600F100 06009080
args 0 0 0 0
end
