name V1 jsr through a register that holds a frame address (a call into the stack), the sentinel read after
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r1
add #16,r1
jsr @r1
nop
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
args 0 0 0 0
end
name V2 trapa with a frame address in r0 and the handler (vector 0x20 of the driver: rte) not captured
asm 06009000
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r0
add #16,r0
.word 0xC320
mov.l @r15,r0
rts
add #24,r15
endasm
args 0 0 0 0
end
