name R9 lent g moves its argument into r9 (a register the default model keeps); P walks down from r9
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov #4,r1
L:
mov.l r1,@-r9
dt r1
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
rts
mov r4,r9
endasm
lend 06009040
args 0 0 0 0
end
name R1 lent g moves its argument into r1; P walks down from r1
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov #4,r2
L:
mov.l r2,@-r1
dt r2
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
rts
mov r4,r1
endasm
lend 06009040
args 0 0 0 0
end
name R0 control: lent g returns its argument in r0 (A3-86b)
asm 06009000
.word 0x082A
add #-24,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009040,r1
jsr @r1
nop
mov r0,r2
mov #4,r1
L:
mov.l r1,@-r2
dt r1
bf L
mov.l @r15,r0
add #24,r15
.word 0x482A
rts
nop
endasm
asm 06009040
rts
mov r4,r0
endasm
lend 06009040
args 0 0 0 0
end
