name S3f probe: unlent U1 hands a laundered copy of its entry r15 to unlent U2 that writes through r4 (the top caller's outgoing slot)
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
.word 0x4F22
mov r15,r4
add #4,r4
swap.w r4,r4
swap.w r4,r4
mov.l =0x06009080,r1
jsr @r1
nop
.word 0x4F26
rts
nop
endasm
asm 06009080
mov #7,r2
mov r3,r1
rts
mov.l r2,@r4
endasm
args 0 0 0 0
end
name S3g control: the same with an exact copy of r15
asm 06009000
.word 0x082A
add #-16,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009040,r1
jsr @r1
nop
mov.l @r15,r0
add #16,r15
.word 0x482A
rts
nop
endasm
asm 06009040
.word 0x4F22
mov r15,r4
add #4,r4
mov.l =0x06009080,r1
jsr @r1
nop
.word 0x4F26
rts
nop
endasm
asm 06009080
mov #7,r2
mov r3,r1
rts
mov.l r2,@r4
endasm
args 0 0 0 0
end
