rts
nop
fn
F1:
mov.l r7,@-r15
mov.l r6,@-r15
mov.l r5,@-r15
add #-4,r15
mov r15,r1
add #4,r1
mov.l r1,@(0,r15)
mov #4,r1
mov #0,r0
F1_L:
mov.l @(0,r15),r2
mov.l @r2+,r3
mov.l r2,@(0,r15)
add r3,r0
dt r1
bf F1_L
add #16,r15
rts
nop
