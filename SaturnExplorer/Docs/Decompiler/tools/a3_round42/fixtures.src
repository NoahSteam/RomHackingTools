# x1: the smallest module: selftest.sh runs it against a substituted generator binary
name x1
ret 1
env SE_GENERATED_CLOBBERS=0
F0:
mov r4,r0
rts
add r5,r0
# d1_unroll: va_arg unrolled, ap in r2 post-incremented four times: r5, r6, r7, then the stack word
name d1_unroll
ret 1,1
env SE_GENERATED_CLOBBERS=0,0
expect 0x2222
F0:
.word 0x4F22
add #-4,r15
mov.l =0x2222,r1
mov.l r1,@(0,r15)
mov #5,r4
mov #6,r5
mov #7,r6
mov #8,r7
mov.l =@F1,r1
jsr @r1
nop
add #4,r15
.word 0x4F26
rts
nop
fn
F1:
mov.l r7,@-r15
mov.l r6,@-r15
mov.l r5,@-r15
mov r15,r2
mov.l @r2+,r0
mov.l @r2+,r3
add r3,r0
mov.l @r2+,r3
add r3,r0
mov.l @r2+,r3
add r3,r0
add #12,r15
rts
nop
