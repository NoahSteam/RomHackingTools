args 0 0 0 0
end

name R14-6d nested: &L in r2 (the structure-return register) instead of r4
asm 06009000
.word 0x4F22
add #-8,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x06009100,r1
jsr @r1
nop
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
.word 0x4F22
add #-4,r15
mov r15,r1
add #8,r1
mov.l r1,@r15
mov r15,r2
mov.l =0x06009200,r3
jsr @r3
nop
mov.l =0x0600F300,r1
mov.l @r1,r1
mov #7,r0
mov.l r0,@r1
add #4,r15
.word 0x4F26
rts
nop
endasm
asm 06009200
mov.l @r2,r1
mov.l =0x0600F300,r3
mov.l r1,@r3
rts
nop
endasm
args 0 0 0 0
end
