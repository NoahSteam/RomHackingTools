name R14-13a frame 0x200, p = sp+0x1c0, stride mov.w =-128 (pool halfword), 3 stores reach sp+0x40
asm 06009000
add #-127,r15
add #-127,r15
add #-127,r15
add #-127,r15
add #-4,r15
mov r15,r2
add #127,r2
add #127,r2
add #127,r2
add #67,r2
mov r15,r3
add #64,r3
mov #5,r0
mov.l r0,@r3
mov.w =0xFF80,r5
mov #3,r1
L:
add r5,r2
mov.l r1,@r2
dt r1
bf L
mov.l @r3,r0
add #127,r15
add #127,r15
add #127,r15
add #127,r15
add #4,r15
rts
nop
endasm
args 0 0 0 0
end

