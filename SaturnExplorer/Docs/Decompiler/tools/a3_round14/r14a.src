name R14-3b control: same with 20 steps of -3 (fewer hops)
asm 06009000
add #-127,r15
add #-33,r15
mov r15,r2
add #127,r2
add #13,r2
mov #5,r0
mov.l r0,@r15
add r4,r2
mov #2,r1
L:
add #-70,r2
mov.b r1,@r2
dt r1
bf L
mov.l @r15,r0
add #127,r15
add #33,r15
rts
nop
endasm
args 0 0 0 0
end

name R14-5 unrolled predecrement stores from sp+16+r4 (no loop)
asm 06009000
add #-24,r15
mov r15,r2
add #16,r2
mov #5,r0
mov.l r0,@r15
add r4,r2
mov #4,r1
mov.l r1,@-r2
mov.l r1,@-r2
mov.l r1,@-r2
mov.l r1,@-r2
mov.l @r15,r0
add #24,r15
rts
nop
endasm
args 0 0 0 0
end
