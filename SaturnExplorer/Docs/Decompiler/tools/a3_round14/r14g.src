quiet
args 0 0 0 0
end

name R14-9d trapa: the handler keeps r4 (vector 5 at vbr+20), rte
asm 06009000
.word 0x4F22
add #-24,r15
mov #1,r0
mov.l r0,@(0,r15)
mov #2,r0
