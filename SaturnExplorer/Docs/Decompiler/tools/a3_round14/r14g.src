name R14-9f trapa handler reads the exception frame: writes 0x55 at its r15+8 (the caller word) through the frame
asm 06009000
.word 0x4F22
add #-8,r15
mov #5,r0
mov.l r0,@r15
mov.l =0x0600F000,r1
ldc r1,vbr
.word 0xC305
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov #0x55,r0
mov.l r0,@(8,r15)
rte
nop
endasm
long 0600F014 06009100
quiet
args 0 0 0 0
end
