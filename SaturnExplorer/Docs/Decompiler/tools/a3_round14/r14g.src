mov #6,r0
mov.l r0,@(20,r15)
mov r15,r4
add #12,r4
mov.l =0x0600F000,r1
ldc r1,vbr
.word 0xC305
mov.l =0x06009000,r1
mov.l =0x0600F100,r6
mov.l @r6,r6
mov #0x55,r2
mov.l r2,@-r6
mov.l r2,@-r6
