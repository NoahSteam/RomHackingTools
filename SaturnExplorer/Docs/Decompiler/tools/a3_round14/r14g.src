name R14-9a delay slot pushes the frame address as the fifth argument (jsr ; mov.l r4,@-r15), g keeps it
asm 06009000
.word 0x4F22
add #-24,r15
mov #1,r0
mov.l r0,@(0,r15)
mov #2,r0
mov.l r0,@(4,r15)
mov #3,r0
mov.l r0,@(8,r15)
mov #4,r0
mov.l r0,@(12,r15)
mov #5,r0
mov.l r0,@(16,r15)
mov #6,r0
mov.l r0,@(20,r15)
mov r15,r4
add #12,r4
mov.l =0x06009100,r1
jsr @r1
mov.l r4,@-r15
add #4,r15
mov.l =0x0600F100,r6
mov.l @r6,r6
mov #0x55,r2
mov.l r2,@-r6
mov.l r2,@-r6
mov.l r2,@-r6
mov.l @(4,r15),r0
add #24,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov.l @r15,r1
mov.l =0x0600F100,r2
mov.l r1,@r2
rts
nop
endasm
quiet
args 0 0 0 0
end

