# b34: a loop: r10 stepped by 1, stored through r4, loaded back, twice (a changed value on every pass)
name b34
ret 0,0,0
env SE_GENERATED_CLOBBERS=0,400,400
.word 0x4F22
mov.l r10,@-r15
mov r4,r10
add #8,r10
mov.l r4,@r10
bsr F2
nop
mov.l r10,@r4
mov.l @r15+,r10
.word 0x4F26
rts
mov #0,r0
fn
F2:
.word 0x4F22
mov #2,r5
K1:
add #1,r10
mov.l r10,@r4
mov.l @r4,r10
dt r5
bf K1
.word 0x4F26
rts
mov r3,r0
fn
G:
mov #4,r10
rts
mov r3,r0
# b35: a loop of the save and restore (d_loop3 again) with an inner stepping of r4 by 4 and back
name b35
ret 0,0,0
env SE_GENERATED_CLOBBERS=0,400,400
.word 0x4F22
mov.l r10,@-r15
mov r4,r10
add #8,r10
mov.l r4,@r10
bsr F2
nop
mov.l r10,@r4
mov.l @r15+,r10
.word 0x4F26
rts
mov #0,r0
fn
F2:
.word 0x4F22
mov #2,r5
K1:
mov.l r10,@r4
add #4,r4
add #-4,r4
mov.l @r4,r10
dt r5
bf K1
.word 0x4F26
rts
mov r3,r0
fn
G:
mov #4,r10
rts
mov r3,r0
