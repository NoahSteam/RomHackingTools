# Area 3, A3-197: fixtures for run197.py (the syntax of round 25's fixtures.src). round 25's vCr8 to vCr14 and vEr8 to vEr14 are run from
# a3_round25 (run.sh here runs both). Each caller saves the register it uses, as compiled code does; F1 is not lent (it reads r3 on entry).
name w1
# control: vCr8 with F1 saving and restoring r8 round its `mov #0,r8` (and not lent: it returns r3): F1 keeps r8, no caution; every run returns 7
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
mov.l r8,@-r15
mov r3,r0
tst r4,r4
bf K1
mov #0,r8
K1:
rts
mov.l @r15+,r8
name w2
# control: vCr8's F1 (clears r8 on one return), but the caller does not read r8 after the call (it restores its own): no caution; returns 5
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r8
rts
nop
K1:
rts
nop
name w3
# r9 = 5 before the call, F1 clears r9 on one return, the caller returns r9 (a copy into r0): the caution; runs return 5 or 0
ret 1,0
.word 0x4F22
mov.l r9,@-r15
mov #5,r9
bsr F1
nop
mov r9,r0
mov.l @r15+,r9
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r9
rts
nop
K1:
rts
nop
name w4
# r11, one level down: F1 (not lent: reads r3) calls G (lent), which clears r11 on one return; F1 does not restore it. The caller adds r11 to 1
# after the call: the caution at the call of F1; runs return 6 or 1
ret 1,0,0
.word 0x4F22
mov.l r11,@-r15
mov #5,r11
bsr F1
nop
mov r11,r0
add #1,r0
mov.l @r15+,r11
.word 0x4F26
rts
nop
fn
F1:
.word 0x4F22
tst r3,r3
bt K0
bsr G
nop
K0:
.word 0x4F26
rts
nop
fn
G:
tst r4,r4
bf K1
mov #0,r11
K1:
rts
nop
name w5
# control: w4 with G saving and restoring r11: no caution; every run returns 6
ret 1,0,0
.word 0x4F22
mov.l r11,@-r15
mov #5,r11
bsr F1
nop
mov r11,r0
add #1,r0
mov.l @r15+,r11
.word 0x4F26
rts
nop
fn
F1:
.word 0x4F22
tst r3,r3
bt K0
bsr G
nop
K0:
.word 0x4F26
rts
nop
fn
G:
mov.l r11,@-r15
tst r4,r4
bf K1
mov #0,r11
K1:
rts
mov.l @r15+,r11
name w6
# w4 with G not lent (it reads r3 too): the walk of F1 takes G's change of r11 from G's own walk; the caution at the call of F1; runs return 6 or 1
ret 1,0,0
.word 0x4F22
mov.l r11,@-r15
mov #5,r11
bsr F1
nop
mov r11,r0
add #1,r0
mov.l @r15+,r11
.word 0x4F26
rts
nop
fn
F1:
.word 0x4F22
tst r3,r3
bt K0
bsr G
nop
K0:
.word 0x4F26
rts
nop
fn
G:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r11
K1:
rts
nop
name w7
# control: w6 with G saving and restoring r11: no caution; every run returns 6
ret 1,0,0
.word 0x4F22
mov.l r11,@-r15
mov #5,r11
bsr F1
nop
mov r11,r0
add #1,r0
mov.l @r15+,r11
.word 0x4F26
rts
nop
fn
F1:
.word 0x4F22
tst r3,r3
bt K0
bsr G
nop
K0:
.word 0x4F26
rts
nop
fn
G:
mov.l r11,@-r15
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r11
K1:
rts
mov.l @r15+,r11
