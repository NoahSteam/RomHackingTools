rts
nop
fn
F1:
tst r4,r4
bf K1
mov #0,r3
rts
nop
K1:
rts
nop
fn
F2:
mov #7,r2
rts
mov.l r2,@r3
name k5
# a loop around the call: three times F1 then *r1 += 1 (every run returns 8)
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
mov #3,r8
L:
bsr F1
nop
mov.l @r1,r2
add #1,r2
dt r8
bf/s L
mov.l r2,@r1
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k5b
# the read before the call in the loop: r1 = &local; L: *r1 += 1; F1; three times (every run returns 8)
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
mov #3,r8
L:
mov.l @r1,r2
add #1,r2
mov.l r2,@r1
bsr F1
nop
dt r8
bf L
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k6
# r14 the frame pointer; lent F1 sets r14 on one return (keeps it on the other); the store of 7 through r14 after the call
