# Area 3 round 25: fixtures for run25.py (the syntax of round 24's fixtures.src). Callers: a local of 5, its address in a register, a call,
# then a store of 7 through the register (or a read); every run returns 7 unless the comment says otherwise.
name k0
# A3-192 copy chain: r1 = &local, lent F1 keeps r1, mov r1,r3, store through r3
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
mov r1,r3
mov #7,r2
mov.l r2,@r3
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k1
# the store through r1 in a bra's delay slot after the call
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
mov #7,r2
bra J
mov.l r2,@r1
J:
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k1r
# the read of the local through r1 in rts's delay slot (every run returns 5; F1 writes nothing)
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
add #8,r15
.word 0x4F26
rts
mov.l @r1,r0
fn
F1:
rts
nop
name k2
# the store on one path only (r5 != 0): returns 7 when r5 != 0, 5 otherwise
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
tst r5,r5
bt S
mov #7,r2
mov.l r2,@r1
S:
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k3
# two calls in a row, F1 keeps r1 (the engine kills r1 at both)
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
bsr F1
nop
mov #7,r2
mov.l r2,@r1
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
name k3b
# two calls, r3: F1 sets r3 on one return (outOrigins names r3), then F2 never touches r3 (keeps it: the engine does not kill it at F2)
ret 1,0,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r3
bsr F1
nop
bsr F2
nop
mov #7,r2
mov.l r2,@r3
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
tst r4,r4
bf K1
mov #0,r3
rts
nop
K1:
rts
nop
fn
F2:
rts
nop
name k4
# the address handed to a second call in r4: F1 keeps r1, F2 (lent) stores 7 through r4
ret 1,0,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
bsr F2
mov r1,r4
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
fn
F2:
mov #7,r2
rts
mov.l r2,@r4
name k4b
# the address handed to a second call in r1: F1 (lent) keeps r1, F2 (not lent: it reads r1) stores 7 through r1
ret 1,0,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r1
bsr F1
nop
bsr F2
nop
mov.l @r15,r0
add #8,r15
.word 0x4F26
rts
nop
fn
F1:
rts
nop
fn
F2:
mov #7,r2
rts
mov.l r2,@r1
name k4c
# control: k4b without F1
ret 1,0
