# Area 3 round 27 review. Run with W=<SaturnExplorer> S=<scratch> run.sh (or run.py <name>). Unless said, a fixture is vCr8's caller (a local of 5,
# its address in r8, the calls, 7 stored through r8, the local returned).
name g1a
# F2 alone (not lent: it returns r3) saves r8 in a fixed word of work RAM, clears r8, restores it from that word: it keeps r8 (every run returns 7). Right: no caution
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F2
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F2:
mov.l =0x0600A000,r1
mov.l r8,@r1
mov #0,r8
mov.l r8,@(4,r1)
mov.l @r1,r8
rts
mov r3,r0
name g1
# vCr8's F1 (clears r8 when r3 != 0 and r4 = 0), then g1a's F2 (keeps r8): runs return 5 or 7 by F1. Right: the caution at F1's call, none at F2's
ret 1,0,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
bsr F2
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
tst r3,r3
bt K1
tst r4,r4
bf K1
mov #0,r8
rts
nop
K1:
rts
nop
fn
F2:
mov.l =0x0600A000,r1
mov.l r8,@r1
mov #0,r8
mov.l r8,@(4,r1)
mov.l @r1,r8
rts
mov r3,r0
