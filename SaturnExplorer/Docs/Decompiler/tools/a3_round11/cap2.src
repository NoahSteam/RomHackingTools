S12:
tst r4,r4
bt S13
add #-4,r2
S13:
tst r4,r4
bt S14
add #-4,r2
S14:
tst r4,r4
bt S15
add #-4,r2
S15:
tst r4,r4
bt S16
add #-4,r2
S16:
tst r4,r4
bt S17
add #-4,r2
S17:
tst r4,r4
bt S18
add #-4,r2
S18:
tst r4,r4
bt S19
add #-4,r2
S19:
mov.l r1,@r2
dt r1
bt OUT
bra L
nop
OUT:
mov.l @r15,r0
add #80,r15
rts
nop
endasm
quiet
args 1 0 0 0
end
