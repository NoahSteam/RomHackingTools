name cap2 k=20 conditional steps in a loop
asm 06009000
add #-80,r15
mov #5,r0
mov.l r0,@r15
mov r15,r2
add #80,r2
mov #1,r1
L:
tst r4,r4
bt S0
add #-4,r2
S0:
tst r4,r4
bt S1
add #-4,r2
S1:
tst r4,r4
bt S2
add #-4,r2
S2:
tst r4,r4
bt S3
add #-4,r2
S3:
tst r4,r4
bt S4
add #-4,r2
S4:
tst r4,r4
bt S5
add #-4,r2
S5:
tst r4,r4
bt S6
add #-4,r2
S6:
tst r4,r4
bt S7
add #-4,r2
S7:
tst r4,r4
bt S8
add #-4,r2
S8:
tst r4,r4
bt S9
add #-4,r2
S9:
tst r4,r4
bt S10
add #-4,r2
S10:
tst r4,r4
bt S11
add #-4,r2
S11:
tst r4,r4
bt S12
