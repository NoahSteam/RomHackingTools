name S7 pointer spilled to an indexed stack slot (r0 index) and reloaded
asm 06009000
add #-32,r15
mov r15,r2
add #16,r2
mov #5,r0
mov.l r0,@r15
mov #20,r0
mov.l r2,@(r0,r15)
mov.l @(r0,r15),r2
mov #4,r1
L:
mov.l r1,@-r2
dt r1
bf L
mov.l @r15,r0
add #32,r15
rts
nop
endasm
args 0 0 0 0
end
