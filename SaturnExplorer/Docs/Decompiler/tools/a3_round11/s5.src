name S20 pointer via mov.l to r14 then walks r14
asm 06009000
add #-24,r15
mov r15,r2
add #16,r2
mov #5,r0
mov.l r0,@r15
mov r2,r14
mov r14,r2
mov #4,r1
L:
mov.l r1,@-r2
dt r1
bf L
mov.l @r15,r0
add #24,r15
rts
nop
endasm
args 0 0 0 0
end
