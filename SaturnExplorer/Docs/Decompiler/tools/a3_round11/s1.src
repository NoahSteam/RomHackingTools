add #-28,r15
mov r15,r2
add #20,r2
mov #5,r0
mov.l r0,@r15
mov.l r2,@(20,r15)
mov.l @(20,r15),r3
mov.l r3,@(24,r15)
mov.l @(24,r15),r2
mov #5,r1
L:
mov.l r1,@-r2
dt r1
bf L
mov.l @r15,r0
add #28,r15
rts
nop
endasm
args 0 0 0 0
end
