asm 06009100
mov.l r8,@-r15
.word 0x4F22
mov.l =0x06009200,r1
jsr @r1
nop
.word 0x4F26
mov.l @r15+,r8
rts
nop
endasm
asm 06009200
mov #4,r1
L:
mov.l r1,@-r4
dt r1
bf L
rts
nop
endasm
lend 06009200 06009100
args 0 0 0 0
end
