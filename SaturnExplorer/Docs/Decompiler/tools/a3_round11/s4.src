name G3 callee steps 16 below with a negated constant (one store)
asm 06009000
.word 0x4F22
add #-20,r15
mov #5,r0
mov.l r0,@r15
mov r15,r4
add #16,r4
mov.l =0x06009100,r1
jsr @r1
nop
mov.l @r15,r0
add #20,r15
.word 0x4F26
rts
nop
endasm
asm 06009100
mov #16,r3
neg r3,r3
add r3,r4
mov #1,r1
mov.l r1,@r4
rts
nop
endasm
lend 06009100
args 0 0 0 0
end
