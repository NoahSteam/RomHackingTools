# Area 3 round 23 fixtures. Run: W=<SaturnExplorer> S=<scratch> run23.py <name> [KEY=VAL ...]
# Common shapes. PRO: sts pr,r3 ; mov.l r3,@-r15 ; mov.l =0x06001010,r7 ; mov #1,r1 ; mov.w r1,@r7 ; P: mov.w @r7,r1 ; tst r1,r1 ; bf P
# G stores r4 through r5.
name j0
# control: cl6 with a label-resolved callee
sts pr,r3
mov.l r3,@-r15
mov.l =0x06001010,r7
mov #1,r1
mov.w r1,@r7
P:
mov.w @r7,r1
tst r1,r1
bf P
mov.l =@G,r2
jsr @r2
nop
mov.l @r15+,r3
lds r3,pr
rts
nop
fn
G:
mov.l r4,@r5
rts
nop
