name m3
# C1(0x0) -> C2 -> F (polls, then calls G); C1 passes 5 and a pointer; C2 passes r4/r5 on and adds r6 = 3; the chain's callers keep r0 from F
ret 0,0,0,0
sts pr,r3
mov.l r3,@-r15
mov.l =@C2,r2
mov #5,r4
mov.l =0x06002300,r5
jsr @r2
mov #1,r6
mov.l @r15+,r3
lds r3,pr
rts
nop
fn
