# Area 3 round 19 fixtures (asm syntax of ../a3_round16/asm.py). Run with run19.sh <name>.
name f3
# A3-167 a store before a poll the analysis takes to run for ever, with a store in the loop's body: dropped, nothing said, r6 dropped from the lent prototype
mov.l =0x06002304,r3
mov.l r6,@r3
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
mov.l r5,@(4,r3)
mov.w @r7,r0
tst #1,r0
bf P
mov.l r0,@r3
rts
nop
name f2
# A3-167 the same with a hardware register written in the body
mov.l =0x06002304,r3
mov.l r6,@r3
mov.l =0x06001010,r7
mov.l =0x25F80000,r8
mov #1,r0
mov.w r0,@r7
P:
mov.w r5,@r8
mov.w @r7,r0
tst #1,r0
bf P
mov.l r0,@r3
rts
nop
name f3c
# A3-167 control: no store after the loop: the store is printed
