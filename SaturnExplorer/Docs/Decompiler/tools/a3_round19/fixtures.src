name f4
# A3-169 a store the next store replaces before the loop: the note says the loop drops it
mov.l =0x06002304,r3
mov.l r5,@r3
mov.l r6,@r3
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
mov.w @r7,r0
tst #1,r0
bf P
rts
nop
name f9
# A3-161 class in an endless loop: iRam = 0 before the loop, a store the code does not make (accepted class, no row)
mov.l =0x06002304,r3
mov #0,r1
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
add #1,r1
mov.l r1,@r3
mov.w @r7,r0
tst #1,r0
bf P
rts
nop
name f4r
# A3-169 control: the same two stores in a function that returns: no caution, the signature lent
mov.l =0x06002304,r3
mov.l r5,@r3
mov.l r6,@r3
rts
nop
