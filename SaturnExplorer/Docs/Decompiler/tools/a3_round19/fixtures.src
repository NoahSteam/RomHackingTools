mov.l r6,@r3
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
mov.l r5,@(4,r3)
mov.w @r7,r0
tst #1,r0
bf P
rts
nop
name f3d
# A3-167 control: an empty body: the note is given and the signature withheld
mov.l =0x06002304,r3
mov.l r6,@r3
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
nop
mov.w @r7,r0
tst #1,r0
bf P
mov.l r0,@r3
rts
nop
name f6
# A3-168 tas.b whose T is stored, before the poll: its write dropped, the note suppressed because the read names the instruction
mov.l =0x06002304,r3
tas.b @r3
movt r1
mov.l r1,@r5
mov.l =0x06001010,r7
mov #1,r0
mov.w r0,@r7
P:
mov.w @r7,r0
tst #1,r0
bf P
mov.b r0,@r3
rts
nop
