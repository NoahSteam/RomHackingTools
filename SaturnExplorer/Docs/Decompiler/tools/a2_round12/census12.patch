+// ---- Area 2 round 11 scratch instrument (SE_VS_CHECK=1): every claimed push-forward is checked against sampled elements of its inputs.
+static uintb vsRandState = 88172645463325252ull;
+static uintb vsRand(void) { vsRandState ^= vsRandState << 13; vsRandState ^= vsRandState >> 7; vsRandState ^= vsRandState << 17; return vsRandState; }
+static bool vsOn(void) { static int on = -1; if (on < 0) on = getenv("SE_VS_CHECK") ? 1 : 0; return on == 1; }
