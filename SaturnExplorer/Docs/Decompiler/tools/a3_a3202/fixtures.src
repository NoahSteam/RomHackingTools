name f1
# A3-204: A3-108's frame note, placed by address too: a frame address in r3 at two calls on two arms (A3-194's k4e caller and callee), joined
ret 1,0
.word 0x4F22
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r3
tst r6,r6
bt A1
bsr F1
