# Area 3, A3-214 fix: fixtures (run with run.sh / run.py: W=<SaturnExplorer> S=<scratch>). The caller is vCr8's (a local of 5, its address in r8,
# the call, 7 stored through r8, the local returned); F1 is U, not lent (it returns r3), so input mode 0 (r3 = 0) takes case 0.
# `.rel A,B` is one word, A - B (a table of half-word offsets); the assembler spells `braf rN` `braf @rN`.
# tb (a3_round28's): U dispatches on r3 & 3 (`and #3,r0`) through a table of addresses; case 0 clears r8 (A3-214)
name tb
ret 1,0
env SE_GENERATED_CLOBBERS=0,100
.word 0x4F22
mov.l r8,@-r15
add #-16,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F1
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #16,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F1:
mov r3,r0
and #3,r0
mov r0,r1
shll2 r1
mova @(T1,pc),r0
mov.l @(r0,r1),r1
jmp @r1
nop
T1:
.addr C0
.addr C1
.addr C1
.addr C1
C0:
mov #0,r8
C1:
rts
mov r3,r0
