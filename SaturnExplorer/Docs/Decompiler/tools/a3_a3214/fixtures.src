and #3,r0
mov.l r0,@-r15
mov.l @r15+,r1
shll2 r1
mova @(T1,pc),r0
mov.l @(r0,r1),r1
jmp @r1
nop
nop
T1:
.addr C0
.addr C1
.addr C1
.addr C1
C0:
mov #0,r8
C1:
rts
mov r3,r0
