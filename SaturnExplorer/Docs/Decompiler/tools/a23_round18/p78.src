rts
mov r4,r0
endasm
lend 06009100
args 1 2 3 4
end

name P5 two registers, second loaded from first callee's kept register r9
asm 06009000
.word 0x4F22
mov.l r9,@-r15
mov.l =0x06009100,r3
mov.l =0x06009120,r9
jsr @r3
nop
mov r0,r4
jsr @r9
nop
jsr @r3
mov r0,r4
mov.l @r15+,r9
.word 0x4F26
rts
nop
endasm
asm 06009100
shll r4
rts
mov r4,r0
endasm
asm 06009120
shll2 r4
rts
mov r4,r0
endasm
lend 06009100 06009120
args 1 2 3 4
end
