name C1 post-increment changes r4
asm 06009000
mov.l @r4+,r0
rts
nop
endasm
args 0x0600A000 0 0 0
end

name C2 pre-decrement store changes r5
asm 06009000
mov.l r6,@-r5
rts
mov #1,r0
endasm
args 0 0x0600A010 7 0
end

name C3 mac.l changes r4 r5
asm 06009000
.word 0x0028
.word 0x054F
.word 0x001A
rts
nop
endasm
args 0x0600A000 0x0600A010 7 0
end

name C4 conditional write of r12 no save
asm 06009000
tst r4,r4
bt L
mov #0,r12
L:
rts
mov r5,r0
endasm
args 0 3 0 0
args 1 3 0 0
end

name C5 r0 written on one path only
asm 06009000
tst r4,r4
bt L
mov #7,r0
L:
rts
nop
endasm
args 0 3 0 0 r0=5
args 1 3 0 0 r0=5
end

name C6 rts slot reads r6
asm 06009000
mov #1,r0
rts
add r6,r0
endasm
args 1 2 3 4
args 1 2 9 4
end

name C7 r7 read only through a push and pop
asm 06009000
mov.l r7,@-r15
mov.l @r15+,r0
rts
nop
endasm
args 1 2 3 4
args 1 2 3 9
end

name C8 r5 read on one path, written first on the other
asm 06009000
tst r4,r4
bt L
rts
mov r5,r0
L:
mov #0,r5
rts
mov r5,r0
endasm
args 0 2 3 4
args 1 2 3 4
end

name C9 dt in a loop changes r4, returns r4
asm 06009000
mov #0,r0
L:
dt r4
bf/s L
add #1,r0
rts
nop
endasm
args 3 2 3 4
end

name C10 tas changes nothing but memory
asm 06009000
.word 0x441B
rts
.word 0x0029
endasm
args 0x0600A000 0 0 0
end

name C11 r1 written, returned in r0:r1? only r1
asm 06009000
mov r4,r1
rts
mov r5,r0
endasm
args 1 2 3 4
end

name C12 ldc.l @r4+,gbr changes r4
asm 06009000
.word 0x4417
.word 0x0012
rts
nop
endasm
args 0x0600A000 0 0 0
end
