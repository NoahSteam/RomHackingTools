mov #0,r9
rts
mov r3,r0
fn
F3:
.word 0x4F22
bsr F2
nop
.word 0x4F26
rts
mov r3,r0
name s15
# r15: A3-206's sp caller (frame in r14, a local of 5 at @r15, 9 above it, `mov.l @r15,r0` returned after the call); F2 keeps PR in r9 around a call of G,
# which pops its caller's word (`add #4,r15`) when r3 != 0. Runs with r3 != 0 return 9. Right: the caution naming r15
ret 1,0,0
.word 0x4F22
mov.l r14,@-r15
add #-8,r15
mov r15,r14
mov #5,r2
mov.l r2,@r15
mov #9,r2
mov.l r2,@(4,r15)
bsr F2
nop
mov.l @r15,r0
mov r14,r15
add #8,r15
mov.l @r15+,r14
.word 0x4F26
rts
nop
fn
F2:
sts pr,r9
bsr G
nop
lds r9,pr
rts
nop
fn
G:
tst r3,r3
bt K1
add #4,r15
K1:
rts
nop
name s15c
