name mt
# a cycle's result taken by another caller: F2 (r4 = 0) clears r9, else saves PR and calls F3 with r4 >> 1; F3 saves PR and calls F2. The caller calls F2, sets
# r9 = 1, calls F3 and returns r9: F3's walk is made inside F2's, with F2's in progress. Every run returns 0 (F2 ends at r4 = 0). Right: the caution at F3's call naming r9
ret 1,0,0
.word 0x4F22
mov.l r9,@-r15
bsr F2
nop
mov #1,r9
bsr F3
nop
mov r9,r0
mov.l @r15+,r9
.word 0x4F26
rts
nop
fn
F2:
tst r4,r4
bt E2
.word 0x4F22
bsr F3
shlr r4
.word 0x4F26
rts
mov r3,r0
