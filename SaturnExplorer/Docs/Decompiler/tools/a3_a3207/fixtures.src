# Area 3, A3-207: a callee that saves PR and calls an unlent callee (a nested call), and recursion. Run with run.sh / run.py (W=<SaturnExplorer> S=<scratch>).
# Unless said, the caller is rc's (A3-197's vCr8 caller: a local of 5, its address in r8, the call of F2, 7 stored through r8, the local returned):
# runs on which F2 clears r8 store through 0 and return 5, the text says `return 7;`. G is not lent (it reads r3).
# w6 (A3-197's fixture, as recorded there): F1 saves PR and calls G, which clears r11 when r4 = 0; the caller returns r11 + 1. Right: the caution naming r11
name w6
ret 1,0,0
.word 0x4F22
mov.l r11,@-r15
mov #5,r11
bsr F1
nop
mov r11,r0
add #1,r0
mov.l @r15+,r11
.word 0x4F26
rts
nop
fn
F1:
.word 0x4F22
tst r3,r3
bt K0
bsr G
nop
K0:
.word 0x4F26
rts
nop
fn
G:
mov r3,r0
tst r4,r4
bf K1
mov #0,r11
K1:
rts
nop
# rc (round 27's, with `shlr r4` for its `add #-1,r4` so that every run ends: at most 32 levels): F2 recursive while r4 != 0, `mov #0,r8` after its own
# recursive `bsr`. Right: the caution naming r8
name rc
ret 1,0
.word 0x4F22
mov.l r8,@-r15
add #-8,r15
mov #5,r2
mov.l r2,@r15
mov r15,r8
bsr F2
nop
mov #7,r2
mov.l r2,@r8
mov.l @r15,r0
add #8,r15
mov.l @r15+,r8
.word 0x4F26
rts
nop
fn
F2:
tst r4,r4
bt E2
.word 0x4F22
shlr r4
bsr F2
nop
.word 0x4F26
mov #0,r8
E2:
rts
mov r3,r0
name n1c
