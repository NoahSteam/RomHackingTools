# Area 3 round 40 review (mk.py): A3-264 to A3-266 (round 38's changes) under review. Run: W=<SaturnExplorer> S=<scratch> run.sh [name]
# s1: over: pop after an inner call, step by 2 and back by 2: r10 comes back as it went in
name s1
ret 0,0,0
env SE_GENERATED_CLOBBERS=0,400,400
.word 0x4F22
mov.l r10,@-r15
mov #5,r10
bsr F2
nop
mov.l r10,@r4
mov.l @r15+,r10
.word 0x4F26
rts
mov #0,r0
fn
F2:
.word 0x4F22
mov.l r10,@-r15
bsr G
nop
mov.l @r15+,r10
add #2,r10
add #-2,r10
.word 0x4F26
rts
mov r3,r0
fn
G:
mov #4,r10
rts
mov r3,r0
